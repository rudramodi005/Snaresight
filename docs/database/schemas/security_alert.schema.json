{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://snaresight.local/schemas/security_alert.schema.json",
  "title": "SnareSight Security Alert Contract",
  "description": "Schema representing explainable, evidence-backed security findings in SnareSight.",
  "type": "object",
  "required": [
    "alert_id",
    "alert_schema_version",
    "alert_type",
    "title",
    "summary",
    "detection_rule_id",
    "detection_rule_version",
    "detection_category",
    "detection_explanation",
    "severity",
    "confidence",
    "assessment_status",
    "evidence_strength",
    "observed_source_id",
    "source_address",
    "decoy_id",
    "target_service",
    "first_observed_at",
    "last_observed_at",
    "generated_at",
    "session_ids",
    "related_event_ids",
    "evidence",
    "recommendations"
  ],
  "not": {
    "anyOf": [
      { "required": ["password"] },
      { "required": ["plaintext_password"] },
      { "required": ["password_hash"] }
    ]
  },
  "properties": {
    "alert_id": {
      "type": "string",
      "format": "uuid"
    },
    "alert_schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "alert_type": {
      "type": "string",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "maxLength": 128
    },
    "summary": {
      "type": "string",
      "maxLength": 512
    },
    "detection_rule_id": {
      "type": "string",
      "pattern": "^RULE-[A-Z0-9_-]+$"
    },
    "detection_rule_version": {
      "type": "string"
    },
    "detection_category": {
      "type": "string",
      "enum": [
        "BRUTE_FORCE",
        "RECONNAISSANCE",
        "CREDENTIAL_STUFFING",
        "COMMAND_INJECTION",
        "DIRECTORY_TRAVERSAL",
        "ANOMALOUS_PROBE",
        "PERSISTENCE"
      ]
    },
    "detection_explanation": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "assessment_status": {
      "type": "string",
      "enum": ["NEW", "TRIAGED", "ESCALATED", "CONTAINED", "FALSE_POSITIVE", "RESOLVED", "CLOSED"]
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["DEFINITIVE", "CORROBORATED", "INDICATIVE", "HEURISTIC"]
    },
    "observed_source_id": {
      "type": "string",
      "maxLength": 64
    },
    "source_address": {
      "type": "string"
    },
    "decoy_id": {
      "type": "string",
      "maxLength": 64
    },
    "target_service": {
      "type": "string",
      "enum": ["WEB_PORTAL", "SSH_DAEMON", "REST_API", "SMB_SHARE"]
    },
    "first_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "session_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^decoy_sess_[a-f0-9]{32}$"
      }
    },
    "related_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "related_alert_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "attack_chain_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "evidence": {
      "type": "object",
      "required": ["summary", "supporting_count", "triggering_conditions"],
      "properties": {
        "summary": { "type": "string" },
        "supporting_count": { "type": "integer", "minimum": 1 },
        "triggering_conditions": { "type": "object" },
        "evidence_references": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" }
        }
      },
      "additionalProperties": false
    },
    "mitre_attack": {
      "type": "object",
      "required": [
        "framework_version",
        "tactic_id",
        "tactic_name",
        "technique_id",
        "technique_name",
        "mapping_confidence",
        "mapping_evidence"
      ],
      "properties": {
        "framework_version": { "type": "string" },
        "tactic_id": { "type": "string", "pattern": "^TA\\d{4}$" },
        "tactic_name": { "type": "string" },
        "technique_id": { "type": "string", "pattern": "^T\\d{4}(\\.\\d{3})?$" },
        "technique_name": { "type": "string" },
        "mapping_confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "mapping_evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "analyst_workflow": {
      "type": "object",
      "properties": {
        "assigned_analyst_id": { "type": ["string", "null"], "maxLength": 64 },
        "investigation_id": { "type": ["string", "null"], "format": "uuid" },
        "analyst_notes_reference": { "type": ["string", "null"], "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "recommendations": {
      "type": "object",
      "required": ["recommended_action", "recommendation_reason", "response_approval_required"],
      "properties": {
        "recommended_action": { "type": "string" },
        "recommendation_reason": { "type": "string" },
        "response_approval_required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
