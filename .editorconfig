# ==============================================================================
# SNARESIGHT — EDITORCONFIG SPECIFICATION
# http://editorconfig.org
# ==============================================================================

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4
max_line_length = 88

[*.{ts,tsx,js,jsx,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

