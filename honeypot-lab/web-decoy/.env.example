# ==============================================================================
# SNARESIGHT WEB-LOGIN DECOY CONFIGURATION
# Local configuration template. Do not commit actual production secrets.
# ==============================================================================

DECOY_ID=WEB-DECOY-01
DECOY_NAME="ApexCore Logistics Employee Access Portal"
ENVIRONMENT=isolated_lab
PROVENANCE_SOURCE=live_honeypot

# Network Binding (Defaults strictly to localhost for safety)
# For isolated lab operations, set BIND_HOST to the verified lab IP (e.g. 192.168.56.10)
# Wildcard 0.0.0.0 is strictly prohibited by security policy.
BIND_HOST=127.0.0.1
BIND_PORT=8080

# Logging Configuration
EVENT_LOG_DIR=./data
EVENT_LOG_FILE=events.jsonl
MAX_LOG_SIZE_BYTES=10485760  # 10 MB limit before rotation

# Privacy & Fingerprint Salt
# Used to compute deterministic HMAC-SHA256 privacy fingerprints of usernames
HMAC_SALT_KEY=replace_with_a_secure_local_random_hex_salt

# Security Limits
MAX_REQUEST_BODY_BYTES=32768  # 32 KB maximum request payload
MAX_USERNAME_LENGTH=128
MAX_PASSWORD_LENGTH=256
SESSION_COOKIE_NAME=apex_session_id
SESSION_LIFETIME_SECONDS=3600

