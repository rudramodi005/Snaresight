# ==============================================================================
# SNARESIGHT — RELEASE CANDIDATE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local runtime. NEVER COMMIT REAL SECRETS.
# ==============================================================================

# Application & Environment Mode
APP_NAME=SnareSight
ENVIRONMENT=development
APP_DEBUG=false

# Backend Server (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# Frontend Dashboard Origin
FRONTEND_PORT=5173
CORS_ORIGINS=["http://127.0.0.1:5173", "http://localhost:5173"]

# PostgreSQL Database Connection
# Standard format: postgresql+psycopg://username:password@hostname:5432/database
DATABASE_URL=postgresql+psycopg://snaresight_app:replace_with_secure_password@127.0.0.1:5432/snaresight
MIGRATION_DATABASE_URL=postgresql+psycopg://snaresight_migrator:replace_with_secure_password@127.0.0.1:5432/snaresight
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Cryptographic & Authentication Secrets
# Generate random 32-byte secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_random_32_byte_hex_secret_key_minimum_length_32
JWT_SECRET_KEY=replace_with_random_32_byte_hex_secret_key_minimum_length_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ENFORCEMENT_MODE=STRICT

# Telemetry Ingestion Collector Authentication
# Pre-shared key between honeypot forwarder and ingestion API gateway
INGESTION_API_KEY=replace_with_random_hex_collector_token

# Rate Limiting & Resource Protection
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
MAX_REQUEST_BODY_SIZE_BYTES=2097152

# Honeypot Sensor Lab Boundaries
DECOY_INTERNAL_SUBNET=172.28.0.0/16
DECOY_DEFAULT_ENVIRONMENT=isolated_lab

# Real-Time Streaming (SSE)
SSE_ENABLED=true
SSE_PING_INTERVAL_SECONDS=15
